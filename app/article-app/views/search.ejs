<!DOCTYPE html>
<html>
<head>
    <title>Articles</title>
</head>
<body>
    <h1>Articles</h1>
    <ul>
        <% articles.forEach(article => { %>
            <li>
                <strong>ID:</strong> <%= article.id %> <br>
                <strong>Name:</strong> <%= article.name %> <br>
                <strong>URL:</strong> <href><%= article.url %></href> <br>
                <strong>Type:</strong> <%= article.type %> <br>
            </li>
        <% }); %>
    </ul>
    <a href="/">Go back</a>
</body>
</html>

